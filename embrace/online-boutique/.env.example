# Required: same value as FRONTEND_API_KEY on the Online Boutique frontend service
VITE_FRONTEND_API_KEY=

# Upstream boutique for relaying /api and /static (Express in npm run dev / npm start, and Vite dev:vite/preview).
# First match wins: VITE_FRONTEND_ORIGIN, then VITE_PROXY_TARGET, then VITE_DEV_PROXY_TARGET, else http://127.0.0.1:8080
# Example workshop: https://workshop.honeydemo.io
# VITE_FRONTEND_ORIGIN=https://workshop.honeydemo.io

# VITE_PROXY_TARGET=http://127.0.0.1:8080
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080

# Default: same-origin API/static (browser → this app’s origin; server relays) — no CORS to the boutique.
# Set to false only for a static deploy that calls the boutique host directly (then set VITE_FRONTEND_ORIGIN for the client).
# VITE_RELATIVE_API=true

# Only when VITE_RELATIVE_API=false: boutique base URL baked into the client bundle (scheme + host + port, no trailing slash).
# VITE_FRONTEND_ORIGIN=https://boutique.example.com

# Optional: router basename if the app is not hosted at the web root (default "").
# VITE_ROUTER_BASENAME=

# Workshop checkout path. Keep true for the bug bounty exercise.
VITE_CHECKOUT_PREFETCH=true